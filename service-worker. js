const CACHE = 'daftar-v3'; 
const FILES = ['./', './index.html', './manifest.json'];

self.addEventListener('install', (e) => {
  e.waitUntil(caches.open(CACHE).then(c => c.addAll(FILES)).then(() => self.skipWaiting()));
});

self.addEventListener('activate', (e) => {
  e.waitUntil(
    caches.keys().then(keys => Promise.all(
      keys.filter(k => k !== CACHE).map(k => caches.delete(k))
    )).then(() => self.clients.claim())
  );
});

self.addEventListener('fetch', (e) => {
  // استراتيجية "الشبكة أولاً" لملف الـ HTML الأساسي لضمان التحديث الفوري
  if (e.request.mode === 'navigate' || e.request.url.includes('index.html') || e.request.url.endsWith('/')) {
    e.respondWith(
      fetch(e.request).then(res => {
        const copy = res.clone();
        caches.open(CACHE).then(c => c.put(e.request, copy));
        return res;
      }).catch(() => caches.match('./index.html'))
    );
  } else {
    // استراتيجية "الكاش أولاً" لبقية الملفات لتكون سريعة وتعمل أوفلاين
    e.respondWith(
      caches.match(e.request).then(r => r || fetch(e.request))
    );
  }
});
